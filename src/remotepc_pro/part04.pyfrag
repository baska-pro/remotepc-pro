tem", "registry", "smss.exe", "csrss.exe", "wininit.exe", "winlogon.exe",
    "services.exe", "lsass.exe", "dwm.exe", "fontdrvhost.exe",
}


def kill_process(process_name):
    target = str(process_name).strip().lower()
    if not target or target in CRITICAL_PROCESS_NAMES:
        return False
    killed = False
    for proc in psutil.process_iter(["name", "pid"]):
        try:
            if (proc.info.get("name") or "").lower() == target and proc.pid != os.getpid():
                proc.kill()
                killed = True
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
    return killed


def kill_process_pid(pid: int):
    try:
        pid = int(pid)
        if pid == os.getpid():
            return False, "Tidak dapat mematikan proses RemotePC sendiri."
        proc = psutil.Process(pid)
        if proc.name().lower() in CRITICAL_PROCESS_NAMES:
            return False, "Proses Windows kritis diblokir untuk keamanan."
        proc.kill()
        return True, f"Proses PID {pid} dimatikan."
    except Exception as exc:
        return False, str(exc)


def get_record_info():
    if not FFMPEG_PATH:
        return "❌ ffmpeg.exe tidak ditemukan. Rekam layar/webcam membutuhkan FFmpeg."
    devices = _ffmpeg_devices()
    videos = "\n".join(f"- {x}" for x in devices.get("video", [])) or "- tidak terdeteksi"
    audios = "\n".join(f"- {x}" for x in devices.get("audio", [])) or "- tidak terdeteksi"
    return f"📡 *Perangkat Perekaman*\n```\nVideo:\n{videos}\n\nAudio:\n{audios}\n```"


def press_key(key):
    try:
        shell = win32com.client.Dispatch("WScript.Shell")
        shell.SendKeys(key)
        return True
    except Exception:
        LOGGER.exception("SendKeys failed: %s", key)
        return False


def beep_alarm(repeats: int = 3, frequency: int = 3000, duration_ms: int = 900) -> None:
    for _ in range(max(1, min(int(repeats), 10))):
        win32api.Beep(int(frequency), int(duration_ms))
        time.sleep(0.25)


def mouse_click(button: str = "left", double: bool = False) -> None:
    if button == "right":
        down, up = win32con.MOUSEEVENTF_RIGHTDOWN, win32con.MOUSEEVENTF_RIGHTUP
    else:
        down, up = win32con.MOUSEEVENTF_LEFTDOWN, win32con.MOUSEEVENTF_LEFTUP
    count = 2 if double else 1
    for idx in range(count):
        win32api.mouse_event(down, 0, 0, 0, 0)
        win32api.mouse_event(up, 0, 0, 0, 0)
        if double and idx == 0:
            time.sleep(0.08)


def run_command_hidden(command: str):
    command = str(command or "").strip()
    if not command:
        raise ValueError("Command kosong")
    LOGGER.info("Launching advanced command: %s", command)
    return subprocess.Popen(["cmd.exe", "/d", "/s", "/c", command], creationflags=CREATE_NO_WINDOW)


def change_volume(action: str) -> bool:
    try:
        key_map = {"up": 0xAF, "down": 0xAE, "mute": 0xAD}
        vk = key_map[action]
        win32api.keybd_event(vk, 0, 0, 0)
        win32api.keybd_event(vk, 0, win32con.KEYEVENTF_KEYUP, 0)
        return True
    except Exception:
        LOGGER.exception("Volume action failed")
        return False


def dashboard_urls():
    dash = CONFIG.get("dashboard", {})
    port = int(dash.get("port", 8765))
    host = str(dash.get("host", "0.0.0.0")).strip() or "0.0.0.0"
    urls = []
    if host in {"127.0.0.1", "localhost", "::1"}:
        urls.append(f"http://127.0.0.1:{port}")
    elif host not in {"0.0.0.0", "::"}:
        urls.append(f"http://{host}:{port}")
    else:
        for _iface, addrs in psutil.net_if_addrs().items():
            for addr in addrs:
                if getattr(addr, "family", None) == socket.AF_INET and not addr.address.startswith("127."):
                    url = f"http://{addr.address}:{port}"
                    if url not in urls:
                        urls.append(url)
        if not urls:
            urls.append(f"http://127.0.0.1:{port}")
    public = str(dash.get("public_base_url", "")).strip().rstrip("/")
    if public and public not in urls:
        urls.insert(0, public)
    return urls


def dashboard_access_text():
    lines = "\n".join(f"• {u}" for u in dashboard_urls()[:6])
    return (
        "🌐 *RemotePC Dashboard*\n"
        f"{lines}\n\n"
        "Login: masukkan Chat ID yang diizinkan → kode OTP dikirim ke bot → masukkan OTP di browser."
    )


def system_snapshot():
    vm = psutil.virtual_memory()
    cpu = psutil.cpu_percent(interval=0.15)
    boot = datetime.fromtimestamp(psutil.boot_time())
    uptime = datetime.now() - boot
    root = os.environ.get("SystemDrive", "C:") + "\\"
    try:
        disk = psutil.disk_usage(root)
        disk_obj = {"total": disk.total, "used": disk.used, "free": disk.free, "percent": disk.percent}
    except Exception:
        disk_obj = {"total": 0, "used": 0, "free": 0, "percent": 0}
    battery = psutil.sensors_battery()
    net = psutil.net_io_counters()
    return {
        "hostname": socket.gethostname(),
        "username": os.getenv("USERNAME", ""),
        "os": f"{platform.system()} {platform.release()} ({platform.version()})",
        "architecture": platform.machine(),
        "cpu_percent": cpu,
        "cpu_physical": psutil.cpu_count(logical=False) or 0,
        "cpu_logical": psutil.cpu_count(logical=True) or 0,
        "ram_total": vm.total,
        "ram_used": vm.used,
        "ram_percent": vm.percent,
        "disk": disk_obj,
        "boot_time": boot.isoformat(timespec="seconds"),
        "uptime_seconds": int(uptime.total_seconds()),
        "battery": None if battery is None else {
            "percent": battery.percent,
            "plugged": battery.power_plugged,
            "secsleft": battery.secsleft,
        },
        "network": {"sent": net.bytes_sent, "recv": net.bytes_recv},
        "ffmpeg": bool(FFMPEG_PATH),
        "nircmd": bool(NIRCMD_PATH),
        "dashboard_urls": dashboard_urls(),
        "pid": os.getpid(),
    }


def human_size(value):
    try:
        n = float(value)
    except Exception:
        return "0 B"
    units = ["B", "KB", "MB", "GB", "TB"]
    for unit in units:
        if n < 1024 or unit == units[-1]:
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024


def normalize_path(raw: str) -> Path:
    value = os.path.expandvars(str(raw or "").strip().strip('"'))
    if not value:
        value = os.path.expanduser("~")
    return Path(value).expanduser().resolve()


def is_protected_path(path: Path) -> bool:
    try:
        p = path.resolve()
        protected = []
        for env_name in ("SystemRoot", "ProgramFiles", "ProgramFiles(x86)", "ProgramData"):
            value = os.environ.get(env_name)
            if value:
                protected.append(Path(value).resolve())
        drive = Path(p.drive + "\\") if p.drive else None
        if drive and p == drive:
            return True
        if p in {Path(__file__).resolve(), CONFIG_PATH.resolve()}:
            return True
        return any(p == x or x in p.pare