.expandvars(configured)).expanduser()
        if not p.is_absolute():
            p = SCRIPT_DIR / p
        candidates.append(p)
    candidates.extend([SCRIPT_DIR / filename, SCRIPT_DIR / "bin" / filename])
    for p in candidates:
        if p.exists():
            return str(p)
    found = shutil.which(filename)
    return found or ""


PATHS_CFG = CONFIG.get("paths", {})
NIRCMD_PATH = _resolve_tool(str(PATHS_CFG.get("nircmd", "")), "nircmd.exe")
FFMPEG_PATH = _resolve_tool(str(PATHS_CFG.get("ffmpeg", "")), "ffmpeg.exe") or shutil.which("ffmpeg") or ""


def _resolve_aux_script(value: str, default_name: str) -> str:
    raw = value or default_name
    p = Path(os.path.expandvars(raw)).expanduser()
    if not p.is_absolute():
        p = SCRIPT_DIR / p
    return str(p)


LOCK_SCRIPT = _resolve_aux_script(str(PATHS_CFG.get("lock_script", "")), "lockscreen.ps1")
MAINTENANCE_SCRIPT = _resolve_aux_script(str(PATHS_CFG.get("maintenance_script", "")), "Maintenance.py")

