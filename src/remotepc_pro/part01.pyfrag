def _deep_merge(base: dict, extra: dict) -> dict:
    out = dict(base)
    for key, value in (extra or {}).items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = _deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def _save_config(config: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, ensure_ascii=False, indent=2), encoding="utf-8")


def _setup_config_if_missing() -> dict:
    env_token = os.getenv("REMOTEPC_BOT_TOKEN", "").strip()
    env_chat = os.getenv("REMOTEPC_ALLOWED_CHAT_IDS", "").strip()
    cfg = _deep_merge(DEFAULT_CONFIG, {})
    if env_token:
        cfg["bot_token"] = env_token
    if env_chat:
        cfg["allowed_chat_ids"] = [x.strip() for x in env_chat.split(",") if x.strip()]
    cfg["secret_key"] = secrets.token_urlsafe(48)

    if not cfg["bot_token"] and sys.stdin and sys.stdin.isatty():
        print("\n=== RemotePC Pro - First Setup ===")
        cfg["bot_token"] = input("Telegram BOT token: ").strip()
        raw_ids = input("Allowed Chat ID (comma separated): ").strip()
        cfg["allowed_chat_ids"] = [x.strip() for x in raw_ids.split(",") if x.strip()]
        port = input("Dashboard port [8765]: ").strip()
        if port.isdigit():
            cfg["dashboard"]["port"] = int(port)
    _save_config(cfg)
    return cfg


def load_config() -> dict:
    if CONFIG_PATH.exists():
        try:
            data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
            cfg = _deep_merge(DEFAULT_CONFIG, data)
        except Exception as exc:
            raise RuntimeError(f"Invalid config file {CONFIG_PATH}: {exc}") from exc
    else:
        cfg = _setup_config_if_missing()
    if not cfg.get("secret_key"):
        cfg["secret_key"] = secrets.token_urlsafe(48)
        _save_config(cfg)
    return cfg


CONFIG = load_config()
BOT_TOKEN = os.getenv("REMOTEPC_BOT_TOKEN", "").strip() or str(CONFIG.get("bot_token", "")).strip()
ALLOWED_CHAT_IDS = {str(x).strip() for x in CONFIG.get("allowed_chat_ids", []) if str(x).strip()}
ALLOWED_CHAT_ID = sorted(ALLOWED_CHAT_IDS)[0] if ALLOWED_CHAT_IDS else ""  # compatibility

if not BOT_TOKEN:
    raise RuntimeError(f"BOT token is empty. Edit {CONFIG_PATH} or set REMOTEPC_BOT_TOKEN.")
if not ALLOWED_CHAT_IDS:
    raise RuntimeError(f"No allowed Chat ID configured. Edit {CONFIG_PATH}.")


