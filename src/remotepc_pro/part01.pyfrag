# ---------- dependency bootstrap ----------
def _module_available(name: str) -> bool:
    try:
        __import__(name)
        return True
    except Exception:
        return False


def bootstrap_dependencies() -> None:
    packages = []
    checks = {
        "requests": "requests>=2.31,<3",
        "psutil": "psutil>=5.9,<8",
        "pyperclip": "pyperclip>=1.9,<2",
        "send2trash": "Send2Trash>=1.8,<2",
        "telegram": "python-telegram-bot>=22.6,<23",
        "flask": "Flask>=3.1,<4",
        "waitress": "waitress>=3,<4",
        "PIL": "Pillow>=10,<13",
    }
    if os.name == "nt":
        checks["win32api"] = "pywin32>=306"
    for module, package in checks.items():
        if not _module_available(module):
            packages.append(package)
    if packages:
        print("[SETUP] Installing required dependencies:", ", ".join(packages))
        subprocess.check_call([
            sys.executable, "-m", "pip", "install", "--disable-pip-version-check", *packages
        ])


bootstrap_dependencies()

